# Per-developer clasp config: scriptId varies per checkout. See
# .clasp.example.json for the template, README.md for setup steps.
.clasp.json

# Per-developer deploy state (the .clasp.json pattern), read by
# scripts/deploy.sh: .deployment-id holds the project's default web-app
# deployment id (dashboard only); .last-deployed records the git SHA the
# script last fully deployed from this checkout (the redundant-run guard).
.deployment-id
.last-deployed
# SPEED-4: .last-gated records the CI gates that already passed at a clean
# commit, so deploying a second project from it skips re-running them.
.last-gated
.last-gated.tmp

# Node tooling (clasp install footprint, etc.)
node_modules/

# Editor / OS noise
.DS_Store
*.swp
*.swo
.idea/
.vscode/

# Audit reports saved by /broad-scan, /audit and /targeted-audit (their SAVE
# REPORT step, claude-workflow-tools v1.56.0). They are written in full,
# unfixed security findings included, and this repository is public, so they
# stay out of git (owner decision 2026-11-23). A report therefore lives only
# in the session that wrote it: a later session needs it pasted. Implement,
# reflect and verification blocks are still committed.
.cycle/blocks/*-scan.md
.cycle/blocks/*-scan-[0-9]*.md
.cycle/blocks/*-audit-*.md
!.cycle/blocks/*-implement.md
